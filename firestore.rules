rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function householdExists(hid) {
      return exists(/databases/$(database)/documents/households/$(hid));
    }

    match /households/{hid} {
      allow get: if signedIn();
      // list 금지가 열거 차단의 핵심: 코드를 모르면 어떤 가구 문서도 찾을 수 없다.
      allow list: if false;
      allow create, delete: if false;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowedNetworks', 'name'])
        && request.resource.data.allowedNetworks is list
        && request.resource.data.allowedNetworks.size() <= 5;

      // 하위 컬렉션을 명시한다. {document=**}는 v2에서 0개 이상 세그먼트에 매칭돼 가구 문서 자체까지 열어
      // list 금지·필드 제한을 무력화한다. householdExists는 없는 가구 경로에 쓰는 쿼터 소진을 막는다.
      match /places/{placeId} { allow read, write: if signedIn() && householdExists(hid); }
      match /items/{itemId}   { allow read, write: if signedIn() && householdExists(hid); }
    }
  }
}
